# ==============================================================================
# PLATAFORMA HOTELERA ORURO (PDHO) - VARIABLES DE ENTORNO DE EJEMPLO
# Lineamientos de Seguridad de la Información (AGETIC: PISI, PISLEA, PIGE)
# ==============================================================================
# NOTA: Este archivo es una plantilla de ejemplo. Copie este archivo a '.env'
# y reemplace los valores con credenciales seguras para su entorno.
# NUNCA suba el archivo '.env' con datos reales al repositorio de control de versiones.

# ------------------------------------------------------------------------------
# 1. SEGURIDAD CRIPTOGRÁFICA Y JWT (AGETIC / PISLEA)
# ------------------------------------------------------------------------------
# Clave secreta para la firma de tokens JWT (HS256).
# Genere una clave robusta ejecutando: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_hexadecimal_aleatoria_de_al_menos_64_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (PIGE / PISI)
# ------------------------------------------------------------------------------
DB_NAME=DB_PDHO
DB_HOST=localhost
DB_USER=postgres
DB_PASS=cambiar_por_password_seguro_postgres
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. SERVIDOR DE CORREO ELECTRÓNICO (NOTIFICACIONES DE CREDENCIALES)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=correo_institucional@ejemplo.bo
EMAIL_HOST_PASSWORD=contrasena_de_aplicacion_smtp

# ------------------------------------------------------------------------------
# 4. POLÍTICAS DE ORIGEN CRUZADO (CORS)
# ------------------------------------------------------------------------------
# Lista JSON o separada por comas de orígenes frontend autorizados
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# ------------------------------------------------------------------------------
# 5. SEMILLA ADMINISTRADOR INICIAL (scripts/seed_admin.py)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@oruro.gob.bo
ADMIN_PASSWORD=AdminSeguro2026!
