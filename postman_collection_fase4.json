{
  "info": {
    "_postman_id": "pdho-fase-4-collection-v2",
    "name": "PDHO - Módulo de Formularios Hoteleros (Carga Manual y Respaldo Digital)",
    "description": "Colección completa para pruebas de creación desde cero, edición, carga manual, foto como respaldo y transformación interna a PDF para los formularios de Estadísticas Hoteleras y Ocupación Hotelera.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token_operador",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "form_estadistica_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "form_ocupacion_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login Operador Hospedaje",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('token_operador', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos_imperio@hotel.bo\",\n  \"password\": \"HotelPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "login"]
            }
          }
        },
        {
          "name": "Login Administrador Departamental",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('token_admin', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin_dept@oruro.gob.bo\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Períodos Disponibles y Calendario Dinámico",
      "item": [
        {
          "name": "Consultar Períodos y Días Reales (Gestión Actual - 2026)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_operador}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/formularios/periodos-disponibles?gestion=2026&tipo_formulario=estadistica",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "formularios", "periodos-disponibles"],
              "query": [
                {
                  "key": "gestion",
                  "value": "2026"
                },
                {
                  "key": "tipo_formulario",
                  "value": "estadistica"
                }
              ]
            },
            "description": "Calcula según calendario real los días de cada mes (ej. 28/29 en febrero, 30 en abril, 31 en agosto). Para la gestión actual, permite únicamente meses anteriores al mes en curso (ej. si hoy es octubre, permite enero a septiembre) y bloquea meses ya declarados."
          }
        },
        {
          "name": "Consultar Períodos y Días Reales (Gestión Pasada - 2025)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_operador}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/formularios/periodos-disponibles?gestion=2025&tipo_formulario=ocupacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "formularios", "periodos-disponibles"],
              "query": [
                {
                  "key": "gestion",
                  "value": "2025"
                },
                {
                  "key": "tipo_formulario",
                  "value": "ocupacion"
                }
              ]
            },
            "description": "Para gestiones pasadas (ej. 2025), permite declarar cualquier mes de enero a diciembre siempre y cuando no haya sido declarado previamente."
          }
        }
      ]
    },
    {
      "name": "3. Respaldo Digital (Foto a PDF)",
      "item": [
        {
          "name": "Subir Foto de Respaldo y Convertir a PDF",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_operador}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Seleccionar fotografía JPG/PNG/WEBP del formulario físico"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/formularios/subir-respaldo?tipo_formulario=estadistica",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "formularios", "subir-respaldo"],
              "query": [
                {
                  "key": "tipo_formulario",
                  "value": "estadistica"
                }
              ]
            },
            "description": "Sube la imagen física, la comprime y transforma internamente a PDF para respaldo legal y ahorro de espacio."
          }
        }
      ]
    },
